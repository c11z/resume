#!/bin/sh
# Bump resume.md's minor version once per commit that modifies it.
# The release workflow (.github/workflows/release.yml) tags a GitHub Release
# whenever resume.md's version changes, so each resume edit should advance it.

f=resume.md

# Only act when resume.md is part of this commit.
git diff --cached --name-only | grep -qx "$f" || exit 0

# If the staged change already touches the version line, respect it
# (e.g. a deliberate major bump) and don't bump again.
if git diff --cached -U0 -- "$f" | grep -q '^[+-]version:'; then
    exit 0
fi

v=$(grep -m1 '^version:' "$f" | sed 's/version: *//')
maj=${v%%.*}
min=${v##*.}
new="${maj}.$((min + 1))"

# Portable in-place edit (works with both BSD and GNU sed).
tmp=$(mktemp)
sed "s/^version: .*/version: ${new}/" "$f" >"$tmp" && mv "$tmp" "$f"

git add "$f"
